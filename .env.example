# ============================================
# Superagent Base Configuration
# Copy to backend/.env (relative to repo root) and fill in values:
#   cp .env.example backend/.env
# ============================================

# Server
LISTEN_ADDR=:8888
LOG_LEVEL=info

# MySQL
# The database name (opencoze) must match MYSQL_DATABASE in docker-compose-dev.yml.
# Replace YOUR_PASSWORD with MYSQL_PASSWORD from docker-compose (default: coze123).
MYSQL_DSN=coze:YOUR_PASSWORD@tcp(127.0.0.1:3306)/opencoze?charset=utf8mb4&parseTime=True&allowNativePasswords=false

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# LLM Model
MODEL_PROTOCOL_0=openai
MODEL_NAME_0=your-model-name
MODEL_ID_0=your-model-id
MODEL_API_KEY_0=YOUR_API_KEY
MODEL_BASE_URL_0=http://127.0.0.1:8000/v1

# Built-in ChatModel
BUILTIN_CM_TYPE=openai
BUILTIN_CM_OPENAI_BASE_URL=http://127.0.0.1:8000/v1
BUILTIN_CM_OPENAI_API_KEY=YOUR_API_KEY
BUILTIN_CM_OPENAI_MODEL=your-model-id

# Observability
SERVICE_NAME=superagent-base
OTEL_ENABLED=false
OTEL_ENDPOINT=otel-collector:4317
# Set METRICS_TOKEN to protect the /metrics endpoint with Bearer auth (recommended in production).
# Leave empty to allow unauthenticated access (development default).
METRICS_TOKEN=

# Langfuse (LLM Observability)
# Set LANGFUSE_ENABLED=true to export traces to Langfuse via OTLP.
# Get keys from your Langfuse project settings.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_SAMPLE_RATE=1.0
# LANGFUSE_DEBUG=false

# Turn Timeout
# Maximum time (seconds) allowed per agent turn. Unset or 0 means no additional limit.
# The parent HTTP request context still applies regardless of this setting.
TURN_TIMEOUT_SECONDS=

# Code Execution Tool
# C-4: code_execute has no sandbox isolation and is disabled by default.
# Set to "true" only in controlled, isolated environments.
CODE_EXECUTE_ENABLED=false

# Evolution (local experience self-evolution)
# Set EVOLUTION_ENABLED=true to activate. Uses the same MySQL database.
EVOLUTION_ENABLED=false
EVOLUTION_SENDER_ID=superagent-node-1
EVOLUTION_MIN_CONFIDENCE=0.5
EVOLUTION_MAX_SUGGESTIONS=3
