# ============================================
# Superagent Base Configuration
# Copy this file to backend/.env and fill in values
# ============================================

# Server
LISTEN_ADDR=:8888
LOG_LEVEL=info

# MySQL
MYSQL_DSN=coze:YOUR_PASSWORD@tcp(127.0.0.1:3306)/opencoze?charset=utf8mb4&parseTime=True&allowNativePasswords=false

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# LLM Model
MODEL_PROTOCOL_0=openai
MODEL_NAME_0=your-model-name
MODEL_ID_0=your-model-id
MODEL_API_KEY_0=YOUR_API_KEY
MODEL_BASE_URL_0=http://127.0.0.1:8000/v1

# Built-in ChatModel
BUILTIN_CM_TYPE=openai
BUILTIN_CM_OPENAI_BASE_URL=http://127.0.0.1:8000/v1
BUILTIN_CM_OPENAI_API_KEY=YOUR_API_KEY
BUILTIN_CM_OPENAI_MODEL=your-model-id

# Observability
SERVICE_NAME=superagent-base
OTEL_ENABLED=false
OTEL_ENDPOINT=otel-collector:4317

# Evolution (local experience self-evolution)
# Set EVOLUTION_ENABLED=true to activate. Uses the same MySQL database.
EVOLUTION_ENABLED=false
EVOLUTION_SENDER_ID=superagent-node-1
EVOLUTION_MIN_CONFIDENCE=0.5
EVOLUTION_MAX_SUGGESTIONS=3
