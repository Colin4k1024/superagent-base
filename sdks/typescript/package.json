{
  "name": "@superagent-ai/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Superagent Base — zero-dependency AI agent client",
  "license": "Apache-2.0",
  "author": "superagent-ai",
  "homepage": "https://github.com/superagent-ai/superagent-base",
  "repository": {
    "type": "git",
    "url": "https://github.com/superagent-ai/superagent-base.git",
    "directory": "sdks/typescript"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai",
    "agent",
    "superagent",
    "llm",
    "streaming",
    "sse",
    "a2ui"
  ],
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
