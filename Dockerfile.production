# Build stage
FROM golang:1.24-alpine AS builder
WORKDIR /build
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /superagent .

# Runtime stage
FROM alpine:3.20
RUN apk --no-cache add ca-certificates tzdata
WORKDIR /app
COPY --from=builder /superagent .
COPY backend/conf ./resources/conf
COPY configs/ ./configs/
EXPOSE 8888 50051
ENTRYPOINT ["/app/superagent"]
