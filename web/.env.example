# Web Environment Configuration Template
# Copy to web/.env.development or web/.env.production and fill in real values.
# These files are git-ignored — never commit real credentials.

# IAM (Identity & Access Management) Configuration
VITE_IAM_CLIENT_ID=YOUR_CLIENT_ID
VITE_IAM_SSO_URL=https://sso.example.com
VITE_IAM_TOKEN_URL=https://api.example.com/oauth/token

# API Base URL
VITE_API_BASE=http://localhost:8888
